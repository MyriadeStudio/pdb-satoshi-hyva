<?php

declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @var Template $block */

?>
<?php
  /* Le titre etait teste sur l'EXISTENCE du bloc, pas sur sa valeur : une page CMS sans
     `content_heading` sortait un <h1> vide. Deux h1 dont un vide sur la meme page, c'est
     une anomalie d'accessibilite et de referencement. On teste la valeur. */
  $titleBlock = $block->getLayout()->getBlock('page.main.title');
  $pageHeading = $titleBlock ? trim((string) $titleBlock->getPageTitle()) : '';
?>
<article>
  <?php if ($pageHeading !== ''): ?>
    <h1
      class="content-wrapper mx-auto mb-7 text-center text-4xl text-fg"
      itemprop="headline"
    >
      <?= /** @noEscape */ $pageHeading ?>
    </h1>
  <?php endif; ?>

  <div
    class="animate-on-transition"
    itemprop="articleBody"
  >
    <?= $block->getChildHtml('cms_page') ?>
  </div>
</article>