<?php
/**
 * « Plus de produits de la collection … » (Amasty Shop By Brand), fiche produit.
 *
 * Le template livré par Amasty rendait ses propres cartes en Alpine à partir d'une requête
 * GraphQL : design étranger au thème (Heroicons, `btn btn-primary` que Satoshi ne compile pas,
 * palette gray-*) et surtout des liens construits sur `url_rewrites[0].url`. Ce champ revient
 * vide dès que les rewrites produit sont portés par le store 0 : `href=""` renvoie alors sur
 * la page courante, donc sur le produit consulté.
 *
 * Ici on garde la sélection d'Amasty (même attribut de marque, même limite, même filtre stock,
 * exclusion du produit courant) et on ne lui demande QUE les identifiants ; le rendu passe par
 * le slider produit du thème, qui utilise `Magento_Catalog::product/list/item.phtml` — la carte
 * exacte des pages catégorie — et des URLs générées côté serveur.
 */

declare(strict_types=1);

use Amasty\ShopbyBrand\Block\Catalog\Product\ProductList\MoreFrom;
use Magento\Framework\View\Element\Template;

/** @var Template $block */

/** @var MoreFrom $moreFrom */
$moreFrom = $block->getLayout()->createBlock(MoreFrom::class);

$productIds = array_values(array_filter(array_map(
    static fn ($product): int => (int) $product->getId(),
    $moreFrom->getItems()
)));

if (!$productIds) {
    return '';
}
?>
<?= /** @noEscape */ $block->getLayout()
    ->createBlock(Template::class)
    ->setData([
        'type' => 'generic',
        'title' => (string) $moreFrom->getTitle(),
        // div : sur la fiche produit, ce titre est de la mise en page, pas un titre de contenu.
        'heading_tag' => 'div',
        'page_size' => count($productIds),
        'additional_filters' => [
            ['field' => 'entity_id', 'value' => $productIds, 'conditionType' => 'in'],
        ],
    ])
    ->setTemplate('Magento_Catalog::product/slider/product-slider.phtml')
    ->toHtml() ?>
