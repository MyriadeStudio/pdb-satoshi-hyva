<?= $block->getChildHtml('more_from_brand_js') ?>
<script>
    function moreFromBrandData() {
        return Object.assign(
            {
                ...amMoreFromBrand(),
                ...amMoreFromBrandSlider()
            }, {
                ['displaySlideAriaCurrent']() {return this.active === this.index},
                ['displaySlideAriaLabel']() {
                    return hyva.str(`${this.$el.dataset.label}`, (this.index / this.pageSize) + 1)
                },
                ['dotOneClass']() {
                    return {
                        'js_dummy_slide w-full md:w-1/2 lg:w-1/3 xl:w-1/4 flex flex-shrink-0 shrink-0 py-1' : this.pageFillers > 0
                    }
                },
                ['dotTwoClass']() {
                    return {
                        'js_dummy_slide w-full md:w-1/2 lg:w-1/3 xl:w-1/4 flex flex-shrink-0 shrink-0 py-1' : this.pageFillers > 1
                    }
                },
                ['dotThreeClass']() {
                    return {
                        'js_dummy_slide w-full md:w-1/2 lg:w-1/3 xl:w-1/4 flex flex-shrink-0 shrink-0 py-1' : this.pageFillers > 2
                    }
                },
                ['previousButtonClass']() {return { 'invisible' : this.active === 0 }},
                ['displaySlideClass']() {
                    return {
                        'hidden': (this.pageSize !== 1 && !!(this.index % this.pageSize))
                    }
                },
                ['displaySlideTextClass']() {
                    return {
                        'bg-black/100 bg-opacity-100': this.active === this.index,
                        'bg-black/25 bg-opacity-25': this.active !== this.index,
                        'hidden': (this.pageSize !== 1 && !!(this.index % this.pageSize))
                    }
                },
                ['nextButtonClass']() {return { 'invisible' : this.active >= this.products.length-this.pageSize }},
                ['previousButtonClickEvent'](event) {
                    this.getSlider().scrollLeft =
                        (this.getSlider().scrollWidth / (this.products.length + this.pageFillers)) * (this.active - this.pageSize);
                    this.active -= this.pageSize;
                },
                ['displaySlideClickEvent'](event) {
                    this.getSlider().scrollLeft =
                        (this.getSlider().scrollWidth / (this.products.length + this.pageFillers)) * this.index;
                    this.active = this.index;
                },
                ['displaySlideTextClickEvent'](event) {
                    this.getSlider().scrollLeft =
                        (this.getSlider().scrollWidth / (this.products.length + this.pageFillers)) * this.index;
                    this.active = this.index;
                },
                ['nextButtonClickEvent'](event) {
                    this.getSlider().scrollLeft =
                        (this.getSlider().scrollWidth / (this.products.length + this.pageFillers)) * (this.active + this.pageSize);
                    this.active += this.pageSize
                },
                ['isProducts']() {return this.products && this.products.length},
                ['isProductsLength']() {return this.products.length && this.products.length > this.pageSize},
                ['moreFromBrandInit']() {return this.moreFromBrandsInit()},
                ['productId']() {return this.product.id},
                /* Satoshi override: the callback handed to $nextTick was a plain function, so its
                   `this` was not the Alpine component and calcActive() threw on every window
                   resize. Hyva writes that snippet inside an Alpine expression, where the bare
                   calcActive() resolves through the component scope; copied into real JS it
                   needs an arrow function. */
                ['resizeWindowDebounceEvent'](event) {this.calcPageSize(); this.$nextTick(() => this.calcActive())},
                ['productSmallImageLabel']() {return this.product.small_image.label},
                ['ariaLabelText']() {return hyva.str(`${this.$el.dataset.label}`, this.product.name)},
                ['addToWishlistClickEvent'](event) {return this.addToWishlist(this.product.id)},
                ['addToCompareClickEvent'](event) {return this.addToCompare(this.product.id)},
                ['productUrl']() {return this.getProductUrl(this.product)},
                ['productName']() {return this.product.name},
                ['isShowPrice']() {return this.product.price_range.minimum_price?.final_price?.value},
                ['brandItemInit']() {return this.$nextTick(() => this.slideRendered())},
                ['productSmallImageUrl']() {return this.product.small_image.url},
                ['formatedPrice']() {
                    return hyva.formatPrice(this.product.price_range.minimum_price.final_price.value)
                }
            }
        )
    }
    window.addEventListener(
        'alpine:init',
        () => Alpine.data(
            'moreFromBrandData',
            moreFromBrandData
        ),
        {once: true}
    );
</script>
<?php isset($hyvaCsp) && $hyvaCsp->registerInlineScript() ?>
