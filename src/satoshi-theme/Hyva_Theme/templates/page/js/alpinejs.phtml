declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

?>
<?php
/*
 * Hyva declares its AlpineJS plugins as child blocks of this one (see the module layout
 * default_hyva.xml). Satoshi ships Alpine itself and its own bundle of plugins in assets/app.js
 * -- intersect included -- so the children are deliberately not rendered as a whole here, to
 * avoid registering the same directives twice.
 *
 * Two plugins are exceptions, because nothing in app.js provides them:
 * - htmldialog: every Hyva modal built on a native dialog element (hyva.modal + x-htmldialog)
 *   stayed closed forever, and third party Hyva compatibility modules rely on it;
 * - snap-slider: the product carousels of Pdb_PageBuilder and Pdb_CatalogWidget use
 *   x-snap-slider, without it their arrows stayed invisible and disabled and the pager inert.
 * Render those children explicitly. The defer plugin is left out on purpose: its gain was measured
 * as marginal, and it only handles components present on first load (SPA navigation, morph).
 */
?>
<?= $block->getChildHtml('alpine-plugin-htmldialog') ?>
<?= $block->getChildHtml('alpine-plugin-snap-slider') ?>
<!-- Inject satoshi custom js logic, AlpineJS included -->
<script type="module"
        src="<?= $escaper->escapeUrl($block->getViewFileUrl('assets/app.js')) ?>"
        defer
        crossorigin
></script>