<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
      <referenceBlock name="page.main.title" remove="true" />
      <referenceBlock name="breadcrumbs" remove="true" />

      <!--
      Extension point of the cart page totals, rendered by Magento_Theme::html/header/cart/minicart-totals.phtml
      between the grand total and the checkout button (e.g. the Alma widget of Pdb_AlmaWidget).
      Declared under checkout.cart, whose Satoshi template does not render its children.
      -->
      <referenceBlock name="checkout.cart">
        <container name="satoshi.cart.totals.after" label="Cart page: below the grand total"/>
      </referenceBlock>
    </body>
</page>
