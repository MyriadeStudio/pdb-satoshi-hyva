<?php

declare(strict_types=1);

use Magento\Framework\View\Element\Template as Block;

/** @var Block $block */

/*
 * Grille de cartes produit « fantômes », affichée le temps qu'une navigation
 * SPA récupère la vraie liste. Les classes de grille reprennent celles de
 * Magento_Catalog::product/list.phtml pour que le passage du squelette au
 * contenu réel ne décale pas la mise en page.
 */
$count = (int) ($block->getData('count') ?: 10);
?>

<div
    class="mb-5 grid grid-cols-2 gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5"
    aria-hidden="true"
>
    <?php for ($i = 0; $i < $count; $i++): ?>
        <div class="card-product flex h-full animate-pulse flex-col motion-reduce:animate-none">
            <div class="aspect-product w-full rounded-xl bg-[--fade-in-bg]"></div>
            <div class="mt-4 h-4 w-4/5 rounded bg-[--fade-in-bg]"></div>
            <div class="mt-2 h-4 w-2/5 rounded bg-[--fade-in-bg]"></div>
            <div class="mt-3 h-4 w-1/3 rounded bg-[--fade-in-bg]"></div>
        </div>
    <?php endfor; ?>
</div>
