<?php
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\Logo\LogoPathResolver;
use Hyva\Theme\ViewModel\Logo\LogoSizeResolver;
use Magento\Framework\Escaper;
use Magento\Theme\Block\Html\Header\Logo;

/** @var Logo $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var LogoSizeResolver $logoSizeResolver */

$storeName = $block->getThemeName() ?? 'Satoshi theme';

$logoSizeResolver = $viewModels->require(LogoSizeResolver::class);
$logoWidth = $logoSizeResolver && $logoSizeResolver->getWidth()
    ? $logoSizeResolver->getWidth()
    : $block->getLogoWidth();
$logoHeight = $logoSizeResolver && $logoSizeResolver->getHeight()
    ? $logoSizeResolver->getHeight()
    : $block->getLogoHeight();

/** @var LogoPathResolver $logoPathResolver */
$logoPathResolver = $block->getData('logoPathResolver');
$logoSrc = $logoPathResolver && method_exists($logoPathResolver, 'getLogoSrc')
    ? $logoPathResolver->getLogoSrc($block->getData('logo_file'))
    : $block->getLogoSrc();

$text_length = strlen($storeName);
$estimated_width = $text_length * 12;

/* Largeur effective du logo desktop : `w-full` borne par ce max-width. Emis seulement
   si une largeur est configuree (sinon la declaration serait invalide et ignoree). */
$logoMaxWidth = $logoWidth ? min((int) $logoWidth, 500) : 0;

/* Hauteur que prend le logo une fois sa largeur bornee. Calculee ICI pour etre juste des
   le premier rendu : sans elle, la premiere peinture utilise la hauteur naturelle puis
   Alpine la corrige, ce qui se voit comme un saut de taille. */
$logoNaturalHeight = ($logoMaxWidth && $logoWidth && $logoHeight)
    ? (int) round(((int) $logoHeight) * ($logoMaxWidth / (int) $logoWidth))
    : 56;

?>

<?php if ($logoSrc): ?>
    <!-- Desktop logo -->
    <!--
        `initialHeight` est la hauteur d'affichage du logo quand le header n'est PAS rétréci ;
        le binding y revient dès que l'ombre du header disparaît.

        Elle ne peut pas se mesurer sur le rendu. Le binding ci-dessous pose `max-height` à
        partir d'`initialHeight` AVANT toute mesure : lire `clientHeight` renvoie donc une
        hauteur déjà bridée par la valeur qu'on cherche à établir, et `initialHeight` reste
        collé à son point de départ. Un logo plus haut que ce point de départ était plafonné
        à vie, et on voyait le rendu naturel sauter vers cette valeur dès l'init d'Alpine
        (constaté sur bijouxrotolo, logo 85x110 affiché à 56).

        On part donc de l'intrinsèque, que le CSS ne contraint pas : `naturalWidth` /
        `naturalHeight`, ramenés à la largeur effective (`max-width`). Et la valeur initiale
        est calculée côté PHP depuis la configuration du logo, pour être juste dès la
        première peinture — plus de saut.

        Sans largeur de logo configurée, on ne connaît pas la largeur d'affichage : on garde
        alors l'ancien repli de 56.
    -->
    <img
        src="<?= $escaper->escapeUrl($logoSrc) ?>"
        alt="<?= $escaper->escapeHtmlAttr($block->getLogoAlt() ? $block->getLogoAlt() : $storeName) ?>"
        width="<?= $escaper->escapeHtmlAttr($logoWidth ?? 200) ?>"
        height="<?= $escaper->escapeHtmlAttr($logoHeight ?? 200) ?>"
        class="w-full transition-all max-md:hidden"
        <?php if ($logoMaxWidth): ?>style="max-width: <?= (int) $logoMaxWidth ?>px"<?php endif; ?>
        x-data="{
            maxWidth: <?= (int) $logoMaxWidth ?>,
            initialHeight: <?= (int) $logoNaturalHeight ?>,
            measure(el) {
                if (this.maxWidth && el.naturalWidth) {
                    this.initialHeight = Math.round(el.naturalHeight * this.maxWidth / el.naturalWidth);
                }
            }
        }"
        x-init="$el.complete && measure($el)"
        @load="measure($el)"
        :style="{
            'max-height': (initialHeight >= 56 && $store.main.isHeaderShadowVisible) ? '56px' : `${initialHeight}px`
        }"
    />

    <!-- Mobile logo -->
    <img
        class="object-contain h-[40px] w-auto md:hidden"
        src="<?= $escaper->escapeUrl($logoSrc) ?>"
        alt="<?= $escaper->escapeHtmlAttr($block->getLogoAlt() ? $block->getLogoAlt() : $storeName) ?>"
        width="<?= $escaper->escapeHtmlAttr($logoWidth ?? 200) ?>"
        height="<?= $escaper->escapeHtmlAttr($logoHeight ?? 200) ?>"
    />
<?php else: ?>
    <svg
        viewBox="0 0 <?= $estimated_width ?> 25"
        class="m-auto h-[40px] w-2/3"
    >
        <text
            text-anchor="middle"
            x="50%"
            y="20"
            filter="url(#border)"
        >
            <?= $escaper->escapeHtml($storeName)?>
        </text>
    </svg>
<?php endif; ?>
