declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\Modal;
use Magento\Framework\View\Element\Template;
use Magento\Framework\Escaper;
use Satoshi\Theme\ViewModel\SvgIcons;

/**
 * @var ViewModelRegistry $viewModels
 * @var Template $block
 * @var Escaper $escaper
 */

/** @var Modal $modalViewModel */
$modalViewModel = $viewModels->require(Modal::class);

/** @var SvgIcons $hyvaicons */
$hyvaicons = $viewModels->require(SvgIcons::class);

/*
 * Satoshi override 1: the product page renders the gift card form twice (desktop layout and
 * mobile popup), so this modal exists twice. The open/close events are therefore dispatched
 * on this wrapper by the owning gift card component instead of on the window, otherwise both
 * native dialogs open at once and only one of them can be closed again.
 *
 * Satoshi override 2: the stock dialog was an unstyled native dialog element (UA border, square
 * corners, a stray close cross floated right and a left-aligned `btn btn-primary` that this
 * theme does not build). It is rebuilt here as a proper panel on the theme's tokens: a titled
 * header with a close icon-button, a body that scrolls inside a viewport-capped panel, and a
 * footer holding the confirm action.
 * The preview itself is an email table injected by `form_js`, hence the width/height guards on
 * `#giftcard-preview-dialog`. The panel is named with `aria-label` rather than `aria-labelledby`:
 * this markup is emitted once and printed twice by the theme, so an id would be duplicated.
 */

$closeButtonHtml = '<button type="button"'
    . ' class="button button--outline-secondary icon-button icon-button--size-sm shrink-0"'
    . ' aria-label="' . $escaper->escapeHtmlAttr(__('Close')) . '"'
    . ' @click="closeGiftCardModal">'
    . $hyvaicons->renderHtml('close')
    . '</button>';

$content = '<div class="flex shrink-0 items-center justify-between gap-5 border-b-1 border-solid'
    . ' border-bg-sunken px-5 py-4">'
    . '<span class="heading heading--sm">'
    . $escaper->escapeHtml(__('Preview Gift Card'))
    . '</span>'
    . $closeButtonHtml
    . '</div>'
    . '<div class="min-h-0 flex-1 overflow-auto p-5">'
    . '<div id="giftcard-preview-dialog"'
    . ' class="mx-auto w-fit max-w-full [&_img]:h-auto [&_img]:max-w-full [&_table]:max-w-full"></div>'
    . '</div>'
    . '<div class="flex shrink-0 justify-end border-t-1 border-solid border-bg-sunken px-5 py-4">'
    . '<button type="button" class="button button--filled-primary button--size-sm"'
    . ' @click="closeGiftCardModal">'
    . '<span>' . $escaper->escapeHtml(__('Ok')) . '</span>'
    . '</button>'
    . '</div>';
?>
<div
    x-data="initGiftCardModal"
    data-amcard-preview-modal
    @open-gift-card-modal="showGiftCardModal"
    @close-gift-card-modal="hideGiftCardModal"
>
    <?= /* @noEscape */ $modalViewModel->createModal()
        ->withDialogRefName('giftcard')
        ->withAriaLabel((string)__('Preview Gift Card'))
        ->withContent($content)
        ->positionCenter()
        ->addDialogClass(
            /* `open:flex`, never a bare `flex`: an author `display` would beat the UA
               `dialog:not([open]){display:none}` rule and leave the panel on the page. */
            'open:flex w-[calc(100%_-_1.5rem)] max-w-[42rem] max-h-[85dvh] flex-col overflow-hidden rounded-md',
            'border-0 bg-bg p-0 text-fg shadow-lg backdrop:bg-overlay-dark'
        );
    ?>
</div>
<script>
    function initGiftCardModal() {
        return Object.assign({}, hyva.modal({
            dialog: 'giftcard'
        }), {
            /* Satoshi override: the option key hyva.modal() reads is `dialog`, not `name`
               (see above); with `name` the component fell back to the default dialog name. */
            init() {},

            closeGiftCardModal() {
                this.$root.dispatchEvent(new CustomEvent('close-gift-card-modal'));
            },

            hideGiftCardModal() {
                return this.hide('giftcard')
            },

            showGiftCardModal() {
                return this.show('giftcard')
            }
        })
    }

    window.addEventListener(
        'alpine:init',
        () => Alpine.data(
            'initGiftCardModal',
            initGiftCardModal
        ),
        {once: true}
    );
</script>
<?php isset($hyvaCsp) && $hyvaCsp->registerInlineScript() ?>
