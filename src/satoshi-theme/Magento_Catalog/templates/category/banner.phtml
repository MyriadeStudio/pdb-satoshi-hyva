<?php

declare(strict_types=1);

use Hyva\Theme\ViewModel\SvgIcons;
use Magento\Framework\Escaper;
use Magento\Catalog\Block\Category\View;
use Magento\Catalog\ViewModel\Category\Image;
use Magento\Catalog\Helper\Output;

/** @var Escaper $escaper */
/** @var View $block */

/** @var ViewModelRegistry $viewModels */
/** @var SvgIcons $hyvaicons */
$hyvaicons = $viewModels->require(SvgIcons::class);

$title = $block->getLayout()->getBlock('page.main.title')->getPageHeading();

$category = $block->getCurrentCategory();
$categoryOutput = $this->helper(Output::class);

if ($description = $category->getDescription()) {
    $descriptionHtml = $categoryOutput->categoryAttribute($category, $description, 'description');
}

$image = $viewModels->require(Image::class);
$width = $block->getVar('category_page_category_image/width');
$height = $block->getVar('category_page_category_image/height');
?>

<?php
    /* Banniere de categorie ET de page marque Amasty (ambrand_index_index passe par ce meme
       template : Amasty pose l'image et la description de la marque sur la categorie courante).
       Avec visuel : desktop 50 % titre + description | 50 % visuel, au format 3:2 jamais
       etire ; mobile, visuel au-dessus du texte. Sans visuel : le texte prend 100 %. */
    $imgUrl = $image->getUrl($category);
?>
<article
    aria-label="<?= __('Category details') ?>"
    class="content-wrapper mx-auto flex flex-col gap-4 pb-6 pt-3 <?= $imgUrl ? 'md:grid md:grid-cols-2 md:items-center md:gap-10' : 'items-start' ?>"
>
    <?php if ($imgUrl): ?>
        <div class="disable-fade contents">
            <img
                src="<?= $escaper->escapeUrl($imgUrl) ?>"
                alt="<?= $escaper->escapeHtmlAttr($category->getName()) ?>"
                class="aspect-[3/2] h-auto w-full rounded-md object-cover"
                <?php if ($width): ?>
                    width="<?= $escaper->escapeHtmlAttr($width) ?>"
                <?php endif; ?>
                <?php if ($height): ?>
                    height="<?= $escaper->escapeHtmlAttr($height) ?>"
                <?php endif; ?>
            />
        </div>
    <?php endif; ?>
    <div class="flex flex-col gap-3 <?= $imgUrl ? 'md:order-first' : '' ?>">
        <!-- Title -->
        <h1 class="text-xl md:text-[32px] text-fg">
            <?= $escaper->escapeHtml((string)$title) ?>
        </h1>

        <!-- Description -->
        <?php if ($description = $category->getDescription()): ?>
            <div class="rte">
                <?= $descriptionHtml ?>
            </div>
        <?php endif; ?>

        <?php if ($block->isContentMode() || $block->isMixedMode()) :?>
            <!-- CMS Block -->
            <div class="rte">
                <?= $block->getCmsBlockHtml() ?>
            </div>
        <?php endif; ?>
    </div>
</article>
