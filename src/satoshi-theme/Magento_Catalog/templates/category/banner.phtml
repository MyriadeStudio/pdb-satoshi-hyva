<?php

declare(strict_types=1);

use Hyva\Theme\ViewModel\SvgIcons;
use Magento\Framework\Escaper;
use Magento\Catalog\Block\Category\View;
use Magento\Catalog\ViewModel\Category\Image;
use Magento\Catalog\Helper\Output;

/** @var Escaper $escaper */
/** @var View $block */

/** @var ViewModelRegistry $viewModels */
/** @var SvgIcons $hyvaicons */
$hyvaicons = $viewModels->require(SvgIcons::class);

$title = $block->getLayout()->getBlock('page.main.title')->getPageHeading();

$category = $block->getCurrentCategory();
$categoryOutput = $this->helper(Output::class);

if ($description = $category->getDescription()) {
    $descriptionHtml = $categoryOutput->categoryAttribute($category, $description, 'description');
}

$image = $viewModels->require(Image::class);
$width = $block->getVar('category_page_category_image/width');
$height = $block->getVar('category_page_category_image/height');
?>

<?php
    /* Banniere de categorie ET de page marque Amasty (ambrand_index_index passe par ce meme
       template : Amasty pose l'image et la description de la marque sur la categorie courante).
       Avec visuel : desktop 50 % titre + description | 50 % visuel, au format 3:2 jamais
       etire ; mobile, visuel au-dessus du texte. Sans visuel : le texte prend 100 %. */
    $imgUrl = $image->getUrl($category);
?>
<article
    aria-label="<?= __('Category details') ?>"
    class="content-wrapper mx-auto flex flex-col gap-4 pb-6 pt-3 <?= $imgUrl ? 'md:grid md:grid-cols-2 md:items-center md:gap-10' : 'items-start' ?>"
>
    <?php if ($imgUrl): ?>
        <div class="disable-fade contents">
            <img
                src="<?= $escaper->escapeUrl($imgUrl) ?>"
                alt="<?= $escaper->escapeHtmlAttr($category->getName()) ?>"
                class="aspect-[3/2] h-auto w-full rounded-md object-cover"
                data-pdb-visuel
                <?php if ($width): ?>
                    width="<?= $escaper->escapeHtmlAttr($width) ?>"
                <?php endif; ?>
                <?php if ($height): ?>
                    height="<?= $escaper->escapeHtmlAttr($height) ?>"
                <?php endif; ?>
            />
        </div>
    <?php endif; ?>
    <div class="flex flex-col gap-3 <?= $imgUrl ? 'md:order-first' : '' ?>">
        <!-- Title -->
        <h1 class="text-xl md:text-[32px] text-fg">
            <?= $escaper->escapeHtml((string)$title) ?>
        </h1>

        <!-- Description -->
        <?php if ($description = $category->getDescription()): ?>
            <?php
            /* Description repliable derrière un bouton « Lire la suite » (styles : components/pdb-desc-repli.css
               du thème enfant). Tout le texte reste dans le HTML : le repli n'est qu'une hauteur maximale posée
               par le CSS, et sans JavaScript aucune classe d'état n'est posée, donc rien n'est replié.

               Le composant Alpine fait deux choses au démarrage :
               - il sort du texte replié les éléments qui doivent rester visibles sous le bouton : les tags
                 « Nos sélections » que l'agence ajoute à la fin de la description, et la phrase de filtre
                 Amasty (span.amshopby-descr) quand elle suit des paragraphes. Sur une page marque, ce même
                 span EST la description (les paragraphes sont dedans, ou il ne contient que du texte) : il
                 reste dans le texte replié ;
               - il mesure le texte pour décider s'il faut un repli. La hauteur repliée est de 4 lignes sur
                 mobile et de 3 sur bureau ; le texte n'est replié que s'il dépasse cette hauteur de plus d'une
                 ligne. Avec un visuel à côté du texte (bannière 50 | 50, bureau seulement), la colonne de texte
                 peut descendre jusqu'à la hauteur du visuel : la hauteur repliée est alors calée sur le visuel,
                 en lignes entières, en réservant 32 px (2 rem, voir min-height du bouton) pour le bouton.
               Il mesure aussi la hauteur du texte entier (--pdb-desc-plein) : le CSS anime la hauteur entre les
               deux valeurs au clic sur le bouton.

               L'attribut key force Alpine morph à recréer le composant quand la navigation SPA arrive sur une
               autre description, au lieu de réconcilier un DOM déjà déplacé par le composant. */
            $descriptionId = 'pdb-desc-' . crc32((string) $descriptionHtml);
            ?>
            <div
                class="pdb-desc"
                key="<?= $escaper->escapeHtmlAttr($descriptionId) ?>"
                :class="{ 'pdb-desc--repliable': repliable, 'pdb-desc--ouvert': ouvert }"
                @resize.window.debounce.150ms="mesurer()"
                x-data="{
                    ouvert: false,
                    repliable: false,
                    max: 0,
                    plein: 0,
                    init() {
                        const corps = this.$refs.corps;
                        const tags = corps.querySelectorAll(`nav[aria-label=&quot;Nos sélections&quot;], [data-pdb-tags], .pdb-tags`);
                        const filtres = corps.querySelector(`p:not(.amshopby-descr p)`) ? corps.querySelectorAll(`.amshopby-descr`) : [];
                        this.$refs.horsRepli.append(...tags, ...filtres);
                        this.mesurer();
                        document.fonts?.ready.then(() => this.mesurer());
                    },
                    mesurer() {
                        const corps = this.$refs.corps;
                        const ligne = parseFloat(getComputedStyle(corps.querySelector(`p`) || corps).lineHeight) || 22;
                        const bureau = window.matchMedia(`(min-width: 768px)`).matches;
                        const visuel = bureau && this.$el.closest(`article`).querySelector(`[data-pdb-visuel]`);
                        let max = (bureau ? 3 : 4) * ligne;
                        if (visuel) {
                            const dispo = visuel.offsetHeight - (this.$el.parentElement.offsetHeight - corps.offsetHeight - (this.$refs.bouton.hidden ? 0 : 32));
                            max = corps.scrollHeight <= dispo ? corps.scrollHeight : Math.max(max, Math.floor((dispo - 32) / ligne) * ligne);
                        }
                        this.max = max;
                        this.plein = corps.scrollHeight;
                        this.repliable = corps.scrollHeight > max + ligne;
                    }
                }"
            >
                <div
                    id="<?= $escaper->escapeHtmlAttr($descriptionId) ?>"
                    class="rte pdb-desc__corps"
                    x-ref="corps"
                    :style="{ '--pdb-desc-max': max + 'px', '--pdb-desc-plein': plein + 'px' }"
                >
                    <?= $descriptionHtml ?>
                </div>
                <button
                    type="button"
                    class="pdb-desc__bouton"
                    hidden
                    :hidden="!repliable"
                    x-ref="bouton"
                    aria-controls="<?= $escaper->escapeHtmlAttr($descriptionId) ?>"
                    aria-expanded="false"
                    :aria-expanded="ouvert.toString()"
                    @click="ouvert = !ouvert"
                >
                    <span x-show="!ouvert"><?= $escaper->escapeHtml(__('Read more')) ?></span>
                    <span x-show="ouvert"><?= $escaper->escapeHtml(__('Show less')) ?></span>
                </button>
                <div class="rte pdb-desc__hors-repli" x-ref="horsRepli"></div>
            </div>
        <?php endif; ?>

        <?php if ($block->isContentMode() || $block->isMixedMode()) :?>
            <!-- CMS Block -->
            <div class="rte">
                <?= $block->getCmsBlockHtml() ?>
            </div>
        <?php endif; ?>
    </div>
</article>
